POSTGRES_DB=melosmarket
POSTGRES_USER=melosmarket
POSTGRES_PASSWORD=replace-with-a-long-random-password

PRIMARY_DOMAIN=melosmarket.hu

MELOSMARKET_JWT_SECRET=replace-with-at-least-32-random-characters-change-me
MELOSMARKET_TOKEN_VALIDITY_HOURS=24
MELOSMARKET_PUBLIC_BASE_URL=https://melosmarket.hu
MELOSMARKET_EMAIL_FROM=melosmarket.hu@gmail.com

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=melosmarket.hu@gmail.com
SPRING_MAIL_PASSWORD=replace-with-gmail-app-password

# Same-domain production uses /api through Nginx, but these are useful if you also test direct API access.
MELOSMARKET_CORS_ALLOWED_ORIGINS=https://melosmarket.hu,https://www.melosmarket.hu
